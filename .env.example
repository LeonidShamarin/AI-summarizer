# Groq — безкоштовно, ~14 400 запитів на добу, без картки.
# Ключ: https://console.groq.com/keys
#
# Змінна БЕЗ префікса VITE_ — це навмисно. Усе з VITE_ вкомпільовується
# у клієнтський бандл і видно кожному; цей ключ читає лише серверна
# функція api/summarize.js.
GROQ_API_KEY=gsk_...
# Провайдери-резерви для ланцюжка фолбеку (поточний Groq -> ці -> останні).
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# В останню чергу (з ключі2.txt):
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY_2=
